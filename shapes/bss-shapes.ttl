@prefix bsssh:   <https://fair.scribis.fr/shapes/bss#> .
@prefix bsspoc:  <https://fair.scribis.fr/ontology/bss#> .

@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .

@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix geo:     <http://www.opengis.net/ont/geosparql#> .
@prefix qudt:    <http://qudt.org/schema/qudt/> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix sosa:    <http://www.w3.org/ns/sosa/> .
@prefix time:    <http://www.w3.org/2006/time#> .


#################################################################
# Reusable node shapes
#################################################################

bsssh:SkosConceptShape
    a sh:NodeShape ;

    sh:nodeKind sh:IRI ;
    sh:class skos:Concept .


bsssh:QuantityValueShape
    a sh:NodeShape ;

    sh:targetClass qudt:QuantityValue ;

    sh:property [
        sh:path qudt:value ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal ;
        sh:message
            "A QUDT QuantityValue must have exactly one decimal qudt:value."@en
    ] ;

    sh:property [
        sh:path qudt:hasUnit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:message
            "A QUDT QuantityValue must have exactly one unit."@en
    ] .


bsssh:TimeInstantShape
    a sh:NodeShape ;

    sh:targetClass time:Instant ;

    sh:property [
        sh:path time:inXSDDate ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:date ;
        sh:message
            "A time instant must contain exactly one xsd:date."@en
    ] .


#################################################################
# Underground work
#################################################################

bsssh:UndergroundWorkShape
    a sh:NodeShape ;

    sh:targetClass bsspoc:UndergroundWork ;

    # Every BSS work must retain its stable BSS identifier.
    sh:property [
        sh:path dcterms:identifier ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:Literal ;
        sh:message
            "A BSS underground work must have exactly one identifier."@en
    ] ;

    # At most one nature in the source model.
    sh:property [
        sh:path bsspoc:hasNature ;
        sh:maxCount 1 ;
        sh:node bsssh:SkosConceptShape ;
        sh:message
            "The nature of an ouvrage must reference a SKOS concept."@en
    ] ;

    # One geometry at most in POC v1.
    sh:property [
        sh:path geo:hasGeometry ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class geo:Geometry ;
        sh:message
            "An ouvrage geometry must reference a GeoSPARQL Geometry."@en
    ] ;

    sh:property [
        sh:path bsspoc:investigationDepth ;
        sh:maxCount 1 ;
        sh:node bsssh:QuantityValueShape
    ] ;

    sh:property [
        sh:path bsspoc:groundElevation ;
        sh:maxCount 1 ;
        sh:node bsssh:QuantityValueShape
    ] ;

    sh:property [
        sh:path bsspoc:casingDiameter ;
        sh:maxCount 1 ;
        sh:node bsssh:QuantityValueShape
    ] ;

    sh:property [
        sh:path bsspoc:isGroundwaterPoint ;
        sh:maxCount 1 ;
        sh:datatype xsd:boolean
    ] ;

    sh:property [
        sh:path bsspoc:hasGeologicalSection ;
        sh:maxCount 1 ;
        sh:datatype xsd:boolean
    ] ;

    sh:property [
        sh:path bsspoc:hasVerifiedGeologicalLog ;
        sh:maxCount 1 ;
        sh:datatype xsd:boolean
    ] ;

    sh:property [
        sh:path bsspoc:locatedInCommune ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class bsspoc:Commune
    ] ;

    sh:property [
        sh:path bsspoc:associatedGeologicalMapSheet ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class bsspoc:GeologicalMapSheet
    ] ;

    # Multi-valued controlled vocabularies.
    sh:property [
        sh:path bsspoc:hasAvailableDocumentType ;
        sh:node bsssh:SkosConceptShape
    ] ;

    sh:property [
        sh:path bsspoc:hasUsage ;
        sh:node bsssh:SkosConceptShape
    ] ;

    sh:property [
        sh:path bsspoc:hasFunction ;
        sh:node bsssh:SkosConceptShape
    ] ;

    sh:property [
        sh:path bsspoc:hasResearchTarget ;
        sh:node bsssh:SkosConceptShape
    ] ;

    sh:property [
        sh:path bsspoc:hasReconnaissanceObjective ;
        sh:node bsssh:SkosConceptShape
    ] ;

    sh:property [
        sh:path bsspoc:exploitsResource ;
        sh:node bsssh:SkosConceptShape
    ] ;

    sh:property [
        sh:path bsspoc:hasUtilisation ;
        sh:node bsssh:SkosConceptShape
    ] ;

    sh:property [
        sh:path bsspoc:hasPhysicalState ;
        sh:maxCount 1 ;
        sh:node bsssh:SkosConceptShape
    ] ;

    sh:property [
        sh:path bsspoc:hasDetailedState ;
        sh:node bsssh:SkosConceptShape
    ] ;

    sh:property [
        sh:path bsspoc:hasExecutionTechnique ;
        sh:node bsssh:SkosConceptShape
    ] .


#################################################################
# GeoSPARQL geometry
#################################################################

bsssh:GeometryShape
    a sh:NodeShape ;

    sh:targetClass geo:Geometry ;

    sh:property [
        sh:path geo:asWKT ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype geo:wktLiteral ;
        sh:message
            "A GeoSPARQL geometry must have exactly one WKT representation."@en
    ] .


#################################################################
# Commune
#################################################################

bsssh:CommuneShape
    a sh:NodeShape ;

    sh:targetClass bsspoc:Commune ;

    sh:property [
        sh:path dcterms:identifier ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:Literal ;
        sh:message
            "A commune must have exactly one identifier."@en
    ] .


#################################################################
# Geological map sheet
#################################################################

bsssh:GeologicalMapSheetShape
    a sh:NodeShape ;

    sh:targetClass bsspoc:GeologicalMapSheet ;

    sh:property [
        sh:path dcterms:identifier ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:Literal ;
        sh:message
            "A geological map sheet must have exactly one identifier."@en
    ] .


#################################################################
# BSS information record
#################################################################

bsssh:BSSRecordShape
    a sh:NodeShape ;

    sh:targetClass bsspoc:BSSRecord ;

    sh:property [
        sh:path dcterms:identifier ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:Literal ;
        sh:message
            "A BSS record must have exactly one BSS identifier."@en
    ] ;

    sh:property [
        sh:path bsspoc:describesWork ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class bsspoc:UndergroundWork ;
        sh:message
            "A BSS record must describe exactly one underground work."@en
    ] ;

    sh:property [
        sh:path bsspoc:recordEntryDate ;
        sh:maxCount 1 ;
        sh:datatype xsd:date
    ] ;

    sh:property [
        sh:path dcterms:modified ;
        sh:maxCount 1 ;
        sh:datatype xsd:date
    ] ;

    sh:property [
        sh:path bsspoc:recordOrganisation ;
        sh:maxCount 1 ;
        sh:node bsssh:SkosConceptShape
    ] ;

    sh:property [
        sh:path rdfs:seeAlso ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI
    ] .


#################################################################
# Groundwater depth observation
#################################################################

bsssh:GroundwaterDepthObservationShape
    a sh:NodeShape ;

    sh:targetClass bsspoc:GroundwaterDepthObservation ;

    sh:property [
        sh:path sosa:hasFeatureOfInterest ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class bsspoc:UndergroundWork ;
        sh:message
            "A groundwater depth observation must reference exactly one BSS ouvrage."@en
    ] ;

    sh:property [
        sh:path sosa:observedProperty ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue bsspoc:groundwaterDepthBelowGround ;
        sh:message
            "A groundwater depth observation must observe groundwaterDepthBelowGround."@en
    ] ;

    # Optional because some source observations may describe e.g. ouvrage sec.
    sh:property [
        sh:path sosa:hasResult ;
        sh:maxCount 1 ;
        sh:node bsssh:QuantityValueShape
    ] ;

    sh:property [
        sh:path sosa:phenomenonTime ;
        sh:maxCount 1 ;
        sh:node bsssh:TimeInstantShape
    ] ;

    sh:property [
        sh:path bsspoc:waterDepthObservationType ;
        sh:maxCount 1 ;
        sh:node bsssh:SkosConceptShape
    ] .