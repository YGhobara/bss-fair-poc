@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<https://fair.scribis.fr/vocab/record-organisation>
    a skos:ConceptScheme ;
    dcterms:title "BSS record organisation vocabulary"@en ;
    dcterms:description
        "Prototype vocabulary derived from values of lex_organisme in the BRGM BSS Loiret export."@en .

<https://fair.scribis.fr/vocab/record-organisation/brgm>
    a skos:Concept ;
    skos:notation "BRGM" ;
    skos:prefLabel "BRGM"@fr ;
    skos:inScheme
        <https://fair.scribis.fr/vocab/record-organisation> .