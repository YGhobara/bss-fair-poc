@prefix bsspoc: <https://fair.scribis.fr/ontology/bss#> .
@prefix geo:    <http://www.opengis.net/ont/geosparql#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix quantitykind: <http://qudt.org/vocab/quantitykind/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix iadopt: <https://w3id.org/iadopt/ont/> .
@prefix prov: <http://www.w3.org/ns/prov#> .

<https://fair.scribis.fr/ontology/bss>
    a owl:Ontology ;
    rdfs:label "BSS FAIR prototype ontology"@en .


# SUBJECT / OBJECT ouvrage
bsspoc:UndergroundWork
    a owl:Class ;
    rdfs:subClassOf geo:Feature ;
    rdfs:label "Ouvrage souterrain BSS"@fr ;
    rdfs:label "BSS underground work"@en ;
    rdfs:comment
        "A subsurface work or feature represented as an ouvrage in the source BSS export."@en .

# PREDICAT legacy
bsspoc:legacyIndex
    a owl:DatatypeProperty ;
    rdfs:domain bsspoc:UndergroundWork ;
    rdfs:range rdfs:Literal ;
    rdfs:label "ancien indice BSS"@fr ;
    rdfs:comment "Legacy BSS index component retained by the source dataset."@en .

# PREDICAT legacy
bsspoc:legacyDesignation
    a owl:DatatypeProperty ;
    rdfs:domain bsspoc:UndergroundWork ;
    rdfs:range rdfs:Literal ;
    rdfs:label "ancienne désignation BSS"@fr .

# PREDICAT aNature / hasNature
bsspoc:hasNature
    a owl:ObjectProperty ;
    rdfs:domain bsspoc:UndergroundWork ;
    rdfs:range skos:Concept ;
    rdfs:label "nature de l'ouvrage"@fr ;
    rdfs:label "work nature"@en ;
    rdfs:comment
        "Associates a BSS underground work with its nature."@en .

# SUBJECT / OBJECT Commune
bsspoc:Commune
    a owl:Class ;
    rdfs:subClassOf geo:Feature ;
    rdfs:label "Commune"@fr ;
    rdfs:label "Municipality"@en .

# PREDICAT situé dans la commune / located in municipality
bsspoc:locatedInCommune
    a owl:ObjectProperty ;
    rdfs:domain bsspoc:UndergroundWork ;
    rdfs:range bsspoc:Commune ;
    rdfs:subPropertyOf geo:sfWithin ;
    rdfs:label "situé dans la commune"@fr ;
    rdfs:label "located in municipality"@en .

# PREDICAT profondeur
bsspoc:investigationDepth
    a owl:ObjectProperty ;
    rdfs:domain bsspoc:UndergroundWork ;
    rdfs:range qudt:QuantityValue ;
    rdfs:label "profondeur d'investigation"@fr ;
    rdfs:label "investigation depth"@en .

# PREDICAT altitude du sol / ground elevation
bsspoc:groundElevation
    a owl:ObjectProperty ;
    rdfs:domain bsspoc:UndergroundWork ;
    rdfs:range qudt:QuantityValue ;
    rdfs:label "altitude du sol"@fr ;
    rdfs:label "ground elevation"@en .

# PREDICAT diamètre du tubage / casing diameter
bsspoc:casingDiameter
    a owl:ObjectProperty ;
    rdfs:domain bsspoc:UndergroundWork ;
    rdfs:range qudt:QuantityValue ;
    rdfs:label "diamètre du tubage"@fr ;
    rdfs:label "casing diameter"@en .

# SUBJECT / OBJECT observation de profondeur d'eau / groundwater depth observation
bsspoc:GroundwaterDepthObservation
    a owl:Class ;
    rdfs:subClassOf sosa:Observation ;
    rdfs:label "observation de profondeur d'eau"@fr ;
    rdfs:label "groundwater depth observation"@en .

# SUBJECT / OBJECT eau souterraine / groundwater
bsspoc:Groundwater
    a iadopt:Entity ;
    rdfs:label "eau souterraine"@fr ;
    rdfs:label "groundwater"@en .

# SUBJECT / OBJECT surface du sol / ground surface
bsspoc:GroundSurface
    a iadopt:Entity ;
    rdfs:label "surface du sol"@fr ;
    rdfs:label "ground surface"@en .

# PREDICAT profondeur d'eau / groundwater depth
bsspoc:groundwaterDepthBelowGround
    a sosa:Property ;
    a iadopt:Variable ;
    rdfs:label "profondeur de l'eau sous le niveau du sol"@fr ;

    iadopt:hasProperty quantitykind:Depth ;
    iadopt:hasObjectOfInterest bsspoc:Groundwater ;
    iadopt:hasContextObject bsspoc:GroundSurface .

# PREDICAT type de document disponible / available document type
bsspoc:hasAvailableDocumentType
    a owl:ObjectProperty ;
    rdfs:domain bsspoc:UndergroundWork ;
    rdfs:range skos:Concept ;
    rdfs:label "type de document disponible"@fr ;
    rdfs:label "available document type"@en ;
    rdfs:comment
        "Indicates a category of documentation reported as available for a BSS underground work."@en .

# PREDICAT usage de l'ouvrage / work usage
bsspoc:hasUsage
    a owl:ObjectProperty ;
    rdfs:domain bsspoc:UndergroundWork ;
    rdfs:range skos:Concept ;
    rdfs:label "usage de l'ouvrage"@fr ;
    rdfs:label "work usage"@en ;
    rdfs:comment
        "Associates a BSS underground work with a usage concept derived from the lex_usage vocabulary."@en .

# PREDICAT fonction de l'ouvrage / work function
bsspoc:hasFunction
    a owl:ObjectProperty ;
    rdfs:domain bsspoc:UndergroundWork ;
    rdfs:range skos:Concept ;
    rdfs:label "fonction de l'ouvrage"@fr ;
    rdfs:label "work function"@en ;
    rdfs:comment
        "Associates a BSS underground work with a function concept derived from the lex_fonction vocabulary."@en .


# PREDICAT objet de recherche / research target
bsspoc:hasResearchTarget
    a owl:ObjectProperty ;
    rdfs:domain bsspoc:UndergroundWork ;
    rdfs:range skos:Concept ;
    rdfs:label "objet de recherche"@fr ;
    rdfs:label "research target"@en .

# PREDICAT objectif de reconnaissance / reconnaissance objective
bsspoc:hasReconnaissanceObjective
    a owl:ObjectProperty ;
    rdfs:domain bsspoc:UndergroundWork ;
    rdfs:range skos:Concept ;
    rdfs:label "objectif de reconnaissance"@fr ;
    rdfs:label "reconnaissance objective"@en .

# PREDICAT ressource exploitée / exploited resource
bsspoc:exploitsResource
    a owl:ObjectProperty ;
    rdfs:domain bsspoc:UndergroundWork ;
    rdfs:range skos:Concept ;
    rdfs:label "ressource exploitée"@fr ;
    rdfs:label "exploited resource"@en .

# PREDICAT utilisation
bsspoc:hasUtilisation
    a owl:ObjectProperty ;
    rdfs:domain bsspoc:UndergroundWork ;
    rdfs:range skos:Concept ;
    rdfs:label "utilisation"@fr ;
    rdfs:label "utilisation"@en .

# PREDICAT état physique / physical state -- BROAD
bsspoc:hasPhysicalState
    a owl:ObjectProperty ;
    rdfs:domain bsspoc:UndergroundWork ;
    rdfs:range skos:Concept ;
    rdfs:label "état physique"@fr ;
    rdfs:label "physical state"@en .

# PREDICAT état détaillé / detailed state -- DETAILED
bsspoc:hasDetailedState
    a owl:ObjectProperty ;
    rdfs:domain bsspoc:UndergroundWork ;
    rdfs:range skos:Concept ;
    rdfs:label "état détaillé"@fr ;
    rdfs:label "detailed state"@en .

# PREDICAT technique d'exécution / execution technique
bsspoc:hasExecutionTechnique
    a owl:ObjectProperty ;
    rdfs:domain bsspoc:UndergroundWork ;
    rdfs:range skos:Concept ;
    rdfs:label "technique d'exécution"@fr ;
    rdfs:label "execution technique"@en .

# SUBJECT / OBJECT feuille de carte géologique / geological map sheet
bsspoc:GeologicalMapSheet
    a owl:Class ;
    rdfs:label "feuille de carte géologique"@fr ;
    rdfs:label "geological map sheet"@en .

# PREDICAT feuille de carte géologique associée / associated geological map sheet
bsspoc:associatedGeologicalMapSheet
    a owl:ObjectProperty ;
    rdfs:domain bsspoc:UndergroundWork ;
    rdfs:range bsspoc:GeologicalMapSheet ;
    rdfs:label "feuille de carte géologique associée"@fr ;
    rdfs:label "associated geological map sheet"@en .

# SUBJECT / OBJECT notice BSS / BSS record
bsspoc:BSSRecord
    a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label "notice BSS"@fr ;
    rdfs:label "BSS record"@en .

# PREDICAT décrit l'ouvrage / describes work
bsspoc:describesWork
    a owl:ObjectProperty ;
    rdfs:domain bsspoc:BSSRecord ;
    rdfs:range bsspoc:UndergroundWork ;
    rdfs:label "décrit l'ouvrage"@fr ;
    rdfs:label "describes work"@en .

# PREDICAT date de saisie de la notice / record entry date
bsspoc:recordEntryDate
    a owl:DatatypeProperty ;
    rdfs:domain bsspoc:BSSRecord ;
    rdfs:range xsd:date ;
    rdfs:label "date de saisie de la notice"@fr ;
    rdfs:label "record entry date"@en .

# PREDICAT organisme associé à la notice / record-associated organisation
bsspoc:recordOrganisation
    a owl:ObjectProperty ;
    rdfs:domain bsspoc:BSSRecord ;
    rdfs:range skos:Concept ;
    rdfs:label "organisme associé à la notice"@fr ;
    rdfs:label "record-associated organisation"@en ;
    rdfs:comment
        "Organisation value derived from lex_organisme."@en .

# PREDICAT type d'observation de profondeur d'eau / water depth observation type
bsspoc:waterDepthObservationType
    a owl:ObjectProperty ;
    rdfs:domain bsspoc:GroundwaterDepthObservation ;
    rdfs:range skos:Concept ;
    rdfs:label "type d'observation de profondeur d'eau"@fr ;
    rdfs:label "water depth observation type"@en .

# PREDICAT est un point d'eau / is groundwater point
bsspoc:isGroundwaterPoint
    a owl:DatatypeProperty ;
    rdfs:domain bsspoc:UndergroundWork ;
    rdfs:range xsd:boolean ;
    rdfs:label "est un point d'eau"@fr ;
    rdfs:label "is groundwater point"@en .

# PREDICAT dispose d'une coupe géologique / has geological section
bsspoc:hasGeologicalSection
    a owl:DatatypeProperty ;
    rdfs:domain bsspoc:UndergroundWork ;
    rdfs:range xsd:boolean ;
    rdfs:label "dispose d'une coupe géologique"@fr ;
    rdfs:label "has geological section"@en .

# PREDICAT dispose d'un log géologique vérifié / has verified geological log
bsspoc:hasVerifiedGeologicalLog
    a owl:DatatypeProperty ;
    rdfs:domain bsspoc:UndergroundWork ;
    rdfs:range xsd:boolean ;
    rdfs:label "dispose d'un log géologique vérifié"@fr ;
    rdfs:label "has verified geological log"@en .